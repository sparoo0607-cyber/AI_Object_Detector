<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="28dp">

        <!-- Top Header & Branding Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAHEY"
                        android:textColor="@color/accent_green"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <Space android:layout_width="10dp" android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_status_active"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/pill_background"
                            android:backgroundTint="@color/accent_green"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI ACTIVE"
                            android:textColor="@color/accent_green"
                            android:textSize="9.5sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.08" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Multimodal Accessibility &amp; Intelligence"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Settings Quick Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="15dp"
                app:backgroundTint="@color/surface_card"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/white"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                android:contentDescription="@string/action_settings" />
        </LinearLayout>

        <!-- Section Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESSIBILITY SUITE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@color/surface_border_subtle" />
        </LinearLayout>

        <!-- ============================================ -->
        <!-- CATEGORY 1: VISION ASSIST (CAMERA-BASED) -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVisionAssist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:contentDescription="Category 1: Vision Assist. For visually impaired users. Camera based AI assistance for objects, danger radar, sign language, and reading text. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_vision_cyber"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Glowing Icon Container -->
                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_green"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_vision_eye"
                            app:tint="@color/accent_green"
                            android:contentDescription="Vision Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VISION ASSIST"
                                android:textColor="@color/accent_green"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04" />

                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_chip_bg"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:text="CAMERA"
                                android:textColor="@color/accent_green"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Visual perception &amp; hazard navigation"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/accent_green"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Modern Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="80 Objects"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Hazard Radar"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Sign ASL"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="OCR Reader"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Sub-info line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/accent_green_glow"
                        android:contentDescription="AI" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="On-Device Camera AI • Gemini 2.0 Reasoning • Voice Output"
                        android:textColor="@color/accent_green_glow"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================ -->
        <!-- CATEGORY 2: SOUND & LANGUAGE ASSIST (MIC ONLY) -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSoundAssist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:contentDescription="Category 2: Sound and Language Assist. Primarily for deaf and hard of hearing users. Live sound alerts, speech transcription, and vibrations without camera. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_sound_cyber"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Glowing Icon Container -->
                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_cyan"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sound"
                            app:tint="@color/accent_cyan"
                            android:contentDescription="Sound Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SOUND ASSIST"
                                android:textColor="@color/accent_cyan"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04" />

                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_chip_bg"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:text="ACOUSTICS"
                                android:textColor="@color/accent_cyan"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Acoustic alerts &amp; live speech captions"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/accent_cyan"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Modern Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Siren / Horn Alerts"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Live Speech"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Haptics"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Sub-info line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/accent_cyan_glow"
                        android:contentDescription="AI" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Microphone Only • Telugu &amp; Multi-Language • No Camera"
                        android:textColor="@color/accent_cyan_glow"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================ -->
        <!-- CATEGORY 3: SPEAK & TRANSLATE ASSIST -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCommunication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:contentDescription="Category 3: Speak and Translate Assist. For people who cannot speak or need communication assistance. Type to speak, quick phrases, and two way translation. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_speak_cyber"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Glowing Icon Container -->
                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_purple"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_translate"
                            app:tint="@color/accent_purple"
                            android:contentDescription="Translate Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SPEAK &amp; TRANSLATE"
                                android:textColor="@color/accent_purple"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04" />

                            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_chip_bg"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:text="VOICE &amp; TTS"
                                android:textColor="@color/accent_purple"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Non-verbal speech &amp; multilingual bridge"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/accent_purple"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Modern Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Type to Speak"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Quick Phrases"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_chip_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="Offline ML Kit"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Sub-info line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/accent_purple_glow"
                        android:contentDescription="AI" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="6 Indian Languages • Offline On-Device • 2-Way Speech"
                        android:textColor="@color/accent_purple_glow"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hackathon Demo Panel Trigger -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:text="🛠️ System Health &amp; Interactive Demo"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="13.5sp"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_demo"
            app:iconTint="@color/black"
            app:iconSize="18dp" />

    </LinearLayout>
</ScrollView>
