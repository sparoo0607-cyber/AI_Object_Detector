<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Top Header & Branding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAHEY"
                    android:textColor="@color/accent_green"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Assistive AI Intelligence Platform"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/surface_card"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/white"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                android:contentDescription="@string/action_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:text="Select an accessibility mode:"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium" />

        <!-- ============================================ -->
        <!-- CATEGORY 1: VISION ASSIST (CAMERA-BASED) -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVisionAssist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#4D10B981"
            app:strokeWidth="1.5dp"
            android:contentDescription="Category 1: Vision Assist. For visually impaired users. Camera based AI assistance for objects, danger radar, sign language, and reading text. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_green"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_vision_eye"
                            app:tint="@color/accent_green"
                            android:contentDescription="Vision Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VISION ASSIST"
                            android:textColor="@color/accent_green"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="For visually impaired users"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/text_muted"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Clean Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="80 Objects"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Hazard Radar"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Sign ASL"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="OCR"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📷 Camera &amp; Gemini Visual Reasoning • Instant Voice"
                    android:textColor="@color/accent_green_glow"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================ -->
        <!-- CATEGORY 2: SOUND & LANGUAGE ASSIST (MIC ONLY) -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSoundAssist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#4D3B82F6"
            app:strokeWidth="1.5dp"
            android:contentDescription="Category 2: Sound and Language Assist. Primarily for deaf and hard of hearing users. Live sound alerts, speech transcription, and vibrations without camera. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_blue"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sound"
                            app:tint="@color/accent_blue"
                            android:contentDescription="Sound Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOUND ASSIST"
                            android:textColor="@color/accent_blue"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="For deaf &amp; hard-of-hearing users"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/text_muted"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Clean Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Siren / Horn Alerts"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Live Voice Captions"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Haptics"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🎙️ Microphone Only • Offline Telugu &amp; Multi-Language"
                    android:textColor="@color/accent_blue_glow"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================ -->
        <!-- CATEGORY 3: SPEAK & TRANSLATE ASSIST -->
        <!-- ============================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCommunication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#4D8B5CF6"
            app:strokeWidth="1.5dp"
            android:contentDescription="Category 3: Speak and Translate Assist. For people who cannot speak or need communication assistance. Type to speak, quick phrases, and two way translation. Double tap to open.">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pill_accent_purple"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_translate"
                            app:tint="@color/accent_purple"
                            android:contentDescription="Translate Icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SPEAK &amp; TRANSLATE"
                            android:textColor="@color/accent_purple"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="For non-verbal communication"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/text_muted"
                        android:contentDescription="Open" />
                </LinearLayout>

                <!-- Clean Feature Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Type to Speak"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Quick Phrases"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Space android:layout_width="6dp" android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/pill_background"
                        android:text="Offline ML Kit"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="⌨️ 6 Indian Languages • 2-Way Translation"
                    android:textColor="@color/accent_purple_glow"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hackathon Demo Panel Trigger -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="🛠️ System Health &amp; Interactive Demo"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_demo"
            app:iconTint="@color/black"
            app:iconSize="18dp" />

    </LinearLayout>
</ScrollView>
