<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Avatar + Title + Menu Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_sahey_avatar"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAHEY"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Assistant"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Menu / Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="22dp"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_hamburger_menu"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:elevation="2dp"
                android:contentDescription="@string/action_settings" />
        </LinearLayout>

        <!-- Big Hero Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="SAHEY"
            android:textColor="@color/primary_blue"
            android:textSize="42sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:includeFontPadding="false" />

        <!-- Tagline & Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="See it. Hear it. Understand it."
            android:textColor="@color/text_primary"
            android:textSize="17.5sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="AI-Powered Assistance for a\nMore Accessible World."
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp" />

        <!-- Central Glowing AI Orb Graphic -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_hero_orb">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat_bubble_wave"
                android:contentDescription="AI Voice Orb" />
        </FrameLayout>

        <!-- Primary CTA: GET STARTED -> -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="GET STARTED     →"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="27dp"
            app:elevation="4dp" />

        <!-- 3 Category Navigation Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <!-- 1. Vision Assist Pill -->
            <LinearLayout
                android:id="@+id/cardVisionAssist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/pill_category_vision"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="4dp"
                android:contentDescription="Category 1: Vision Assist">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_vision_eye"
                    app:tint="@color/primary_blue"
                    android:contentDescription="Vision" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="VISION\nASSIST"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <!-- 2. Sound Assist Pill -->
            <LinearLayout
                android:id="@+id/cardSoundAssist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/pill_category_sound"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="4dp"
                android:contentDescription="Category 2: Sound Assist">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sound"
                    app:tint="@color/accent_green"
                    android:contentDescription="Sound" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="SOUND\nASSIST"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>

            <Space android:layout_width="8dp" android:layout_height="wrap_content" />

            <!-- 3. Speak & Translate Pill -->
            <LinearLayout
                android:id="@+id/cardCommunication"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/pill_category_speak"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="4dp"
                android:contentDescription="Category 3: Speak and Translate">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_translate"
                    app:tint="@color/accent_purple"
                    android:contentDescription="Speak" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="SPEAK &amp;\nTRANSLATE"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subtitle & Dots -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Your AI Companion for\nEvery Step, Every Voice, Every Moment."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/primary_blue"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/surface_border"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/surface_border" />
        </LinearLayout>

        <!-- Demo Panel Button (Clean Outline Style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="🛠️ System Health &amp; Subsystems Demo"
            android:textColor="@color/primary_blue"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="@color/primary_blue_light"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_demo"
            app:iconTint="@color/primary_blue"
            app:iconSize="18dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
