<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:paddingHorizontal="22dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- Brand Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAHAY"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Assistive AI Intelligence"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Offline Status Badge Pill -->
        <LinearLayout
            android:id="@+id/offlineBadgeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_accent_green"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/accent_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvOfflineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On-Device AI Active"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- SEE Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSee"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:padding="20dp"
        android:background="@drawable/card_see_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/cardListen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <!-- Top row: Icon Badge + Arrow -->
        <LinearLayout
            android:id="@+id/seeIconBox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/pill_accent_green"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_vision_eye"
                app:tint="@color/accent_green"
                android:contentDescription="Vision" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/text_muted"
            app:layout_constraintTop_toTopOf="@id/seeIconBox"
            app:layout_constraintBottom_toBottomOf="@id/seeIconBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Open SEE" />

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvSeeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SEE"
            android:textColor="@color/accent_green"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toBottomOf="@id/seeIconBox"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSeeDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Real-time Vision &amp; Object Recognition"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvSeeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Feature Chips -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="Objects"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="Signboard Text"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="₹ Currency"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LISTEN Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardListen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:background="@drawable/card_listen_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/cardSee"
        app:layout_constraintBottom_toTopOf="@id/btnAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1">

        <!-- Top row: Icon Badge + Arrow -->
        <LinearLayout
            android:id="@+id/listenIconBox"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/pill_accent_cyan"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_audio_wave"
                app:tint="@color/accent_cyan"
                android:contentDescription="Audio" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/text_muted"
            app:layout_constraintTop_toTopOf="@id/listenIconBox"
            app:layout_constraintBottom_toBottomOf="@id/listenIconBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Open LISTEN" />

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvListenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="LISTEN"
            android:textColor="@color/accent_cyan"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toBottomOf="@id/listenIconBox"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvListenDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Live Whisper Captions &amp; Sound Alerts"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvListenTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Feature Chips -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="Whisper AI"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="Acoustic Alerts"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:background="@drawable/pill_background"
                android:text="Offline"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Admin Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdmin"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:minHeight="42dp"
        android:text="⚙ Admin Control Center"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/surface_card"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="1dp"
        app:cornerRadius="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
