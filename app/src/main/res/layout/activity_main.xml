<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview View (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Custom Canvas Overlay for Bounding Boxes and Labels -->
    <com.accessibility.detector.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Floating Navigation & Control Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackMain"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/ic_back_arrow"
            app:iconTint="@color/white"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:backgroundTint="@color/surface_glass"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:contentDescription="Go Back" />

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <!-- App Mode Indicator Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:backgroundTint="@color/surface_glass"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/accent_green" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vision Active"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content" />

        <!-- Mute / Unmute Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMuteToggle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="@string/mute"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent_green"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_speaker"
            app:iconTint="@color/black"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            android:contentDescription="@string/mute" />
    </LinearLayout>

    <!-- Auto-Scan Live Indicator Pill -->
    <TextView
        android:id="@+id/tvAutoScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/pill_accent_cyan"
        android:text="● Continuous AI"
        android:textColor="@color/accent_cyan_glow"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Result Banner Card (Signboard / Currency / Scene Recognition) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seeResultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/surface_glass"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSeeResultTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/pill_accent_green"
            android:text="DETECTED"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvSeeResultText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/tvSeeResultTag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSeeResultMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tvSeeResultText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Floating Announcement Card (Clean, High Contrast, Accessible) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:padding="20dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/surface_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLiveLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/status_scanning"
            android:textColor="@color/accent_green"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvDetailText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scanning surroundings in real-time"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvLiveLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvFpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="On-Device Inference Active"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp"
            app:layout_constraintTop_toBottomOf="@id/tvDetailText"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permission Container (Displayed if camera permission is needed) -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="28dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_camera"
            android:contentDescription="Camera required"
            app:tint="@color/accent_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/camera_permission_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="sans-serif-black"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/camera_permission_message"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="@string/grant_permission"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent_green"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
