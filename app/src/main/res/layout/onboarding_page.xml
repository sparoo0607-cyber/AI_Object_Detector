<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="36dp">

    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_onb_squircle">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/onb_accent"
            tools:src="@drawable/ic_camera" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:text="Vision Assist"
        android:textColor="@color/onb_title"
        android:textSize="25sp"
        android:textStyle="bold"
        tools:text="Customer Communication" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/onb_body"
        android:textSize="14sp"
        tools:text="You have the opportunity to create completely innovative communication channels with your customers." />

</LinearLayout>
