<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.accessibility.detector.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== Top bar ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/pill"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvModeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_vision_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/accent_green" />

            <TextView
                android:id="@+id/tvLiveLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_scanning"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="#B0BEC5" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMuteToggle"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/status_muted"
            app:icon="@drawable/ic_speaker" />
    </LinearLayout>

    <!-- ===== Gemini status banner ===== -->
    <LinearLayout
        android:id="@+id/geminiStatusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="96dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_surface_container_high"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGeminiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- ===== Right action rail ===== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/pill"
        android:orientation="vertical"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSafetyShield"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginVertical="4dp"
            android:contentDescription="@string/status_safety_mode"
            app:icon="@drawable/ic_shield"
            app:iconTint="@color/accent_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignModeToggle"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginVertical="4dp"
            android:contentDescription="@string/onb_speak_title"
            app:icon="@drawable/ic_sign"
            app:iconTint="@color/accent_cyan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForceReadText"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginVertical="4dp"
            android:contentDescription="@string/onb_vision_title"
            app:icon="@drawable/ic_book"
            app:iconTint="@color/accent_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskGemini"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginVertical="4dp"
            android:contentDescription="@string/onb_welcome_title"
            app:icon="@drawable/ic_demo" />
    </LinearLayout>

    <!-- ===== Voice-confirm card (read text?) ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/voiceConfirmPromptCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvVoiceConfirmPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Sahey.Title"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelRead"
                    style="@style/Widget.Sahey.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmRead"
                    style="@style/Widget.Sahey.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Read it" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== Sign-mode sentence sheet ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/signSentenceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="28dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tvCurrentSignBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_container"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Ready"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/accent_cyan" />

            <TextView
                android:id="@+id/tvAccumulatedSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minLines="2"
                android:textAppearance="@style/TextAppearance.Sahey.Title"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSentence"
                    style="@style/Widget.Sahey.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeakSentence"
                    style="@style/Widget.Sahey.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Speak" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitSignMode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Exit sign mode" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== Permission gate ===== -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_camera"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/permission_camera_mic"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            style="@style/Widget.Sahey.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/grant_permission" />
    </LinearLayout>

</FrameLayout>
