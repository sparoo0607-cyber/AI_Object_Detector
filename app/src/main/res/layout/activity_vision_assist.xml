<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Custom Multi-Layer Canvas Overlay -->
    <com.accessibility.detector.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Floating Navigation Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/surface_glass"
            app:icon="@drawable/ic_back_arrow"
            app:iconTint="@color/white"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Go back to Home Screen" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <!-- Title Badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:backgroundTint="@color/surface_glass"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/pill_background"
                android:backgroundTint="@color/accent_green"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvModeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vision Assist"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <!-- Dedicated Sign Mode Toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignModeToggle"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/surface_glass"
            app:icon="@drawable/ic_sign"
            app:iconTint="@color/accent_cyan"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Toggle Sign Language Mode" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <!-- Safety Shield (Emergency Mode) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSafetyShield"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/surface_glass"
            app:icon="@drawable/ic_shield"
            app:iconTint="@color/accent_red"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:contentDescription="Toggle Emergency Hazard Safety Shield" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <!-- Mute / Unmute Toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMuteToggle"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/accent_green"
            app:icon="@drawable/ic_speaker"
            app:iconTint="@color/black"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            android:contentDescription="Mute or Unmute Voice Output" />
    </LinearLayout>

    <!-- Gemini Cloud Reasoning Activity Banner -->
    <LinearLayout
        android:id="@+id/geminiStatusBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/pill_accent_cyan"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/accent_cyan_glow" />

        <TextView
            android:id="@+id/tvGeminiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Gemini AI is analyzing the scene..."
            android:textColor="@color/accent_cyan_glow"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- 🤟 DEDICATED SIGN LANGUAGE SENTENCE BUILDER CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/signSentenceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_glass"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/accent_cyan"
        app:strokeWidth="1.5dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/geminiStatusBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🤟 SIGN LANGUAGE BUILDER"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvCurrentSignBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_accent_cyan"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Sign: Ready"
                    android:textColor="@color/accent_cyan_glow"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Live Accumulated Sentence Text -->
            <TextView
                android:id="@+id/tvAccumulatedSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="50dp"
                android:text="Show sign gestures to the camera — words will assemble into sentences here..."
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp" />

            <!-- Sentence Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeakSentence"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1.3"
                    android:text="🔊 Speak Sentence"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="12dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSentence"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Clear"
                    android:textColor="@color/white"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/surface_dark"
                    app:strokeColor="@color/surface_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExitSignMode"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Exit"
                    android:textColor="@color/accent_red"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/surface_dark"
                    app:strokeColor="@color/surface_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Voice Confirmation Prompt Card -->
    <LinearLayout
        android:id="@+id/voiceConfirmPromptCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/surface_glass"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/signSentenceCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvVoiceConfirmPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Text detected. Would you like me to read it?"
            android:textColor="@color/accent_yellow"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Say &quot;Yes&quot; or &quot;Read&quot;, or tap Read Now below:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmRead"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Read Now"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_yellow"
                app:cornerRadius="12dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRead"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/surface_dark"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Status Card & Actions -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/bottomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:backgroundTint="@color/surface_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLiveLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_scanning"
                android:textColor="@color/accent_green"
                android:textSize="19sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Objects • Danger Radar • Sign Language • Image OCR"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Vision Assist Dual Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- 1. Ask Gemini AI Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAskGemini"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="🤖 Ask AI (Scene)"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@color/accent_cyan"
                app:cornerRadius="24dp"
                android:contentDescription="Ask Gemini Visual AI to describe everything around you" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <!-- 2. Scan & Read Text Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForceReadText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📖 Read Text"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@color/accent_yellow"
                app:cornerRadius="24dp"
                android:contentDescription="Read detected text out loud" />
        </LinearLayout>
    </LinearLayout>

    <!-- Permission Container -->
    <LinearLayout
        android:id="@+id/permissionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="28dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_camera"
            android:contentDescription="Camera required"
            app:tint="@color/accent_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/permission_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:fontFamily="sans-serif-black"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vision Assist requires Camera and Audio permissions to detect objects and answer your voice commands."
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="@string/grant_permission"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent_green"
            app:cornerRadius="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
