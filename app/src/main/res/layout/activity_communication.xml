<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header & Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/surface_dark"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/white"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                android:contentDescription="Back to Home" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗣️ SPEAK &amp; TRANSLATE"
                    android:textColor="@color/accent_purple"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type what you want to communicate"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. LARGE TEXT INPUT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/accent_purple"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:gravity="top|start"
                    android:hint="Type what you want to say..."
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine|textCapSentences" />

                <!-- Action Controls: Speak, Repeat, Stop, Clear -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Primary Speak Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeak"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:text="🔊 Speak Aloud"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:backgroundTint="@color/accent_purple"
                        app:cornerRadius="12dp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <!-- Repeat -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="Repeat"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:backgroundTint="@color/surface_dark"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/surface_border"
                        app:strokeWidth="1dp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <!-- Clear -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="0.9"
                        android:text="Clear"
                        android:textColor="@color/accent_red"
                        android:textSize="13sp"
                        app:backgroundTint="@color/surface_dark"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/surface_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. TRANSLATE & SPEAK SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TRANSLATE &amp; SPEAK"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Translate to: Telugu / Hindi / Spanish"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslateAndSpeak"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="🌍 Translate &amp; Speak"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTranslatedOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Translated speech will appear and play here."
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. ONE-TAP QUICK COMMUNICATION PHRASES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="QUICK ONE-TAP PHRASES"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseHelp"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="🆘 I NEED HELP"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseWater"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="💧 NEED WATER"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_blue"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseFood"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="🍲 NEED FOOD"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_yellow"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseHospital"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="🏥 HOSPITAL"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseThanks"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="🙏 THANK YOU"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhraseYesNo"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_columnWeight="1"
                android:text="✅ YES / ❌ NO"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_card"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </GridLayout>

        <!-- 4. TWO-WAY CONVERSATION MIC LISTENER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TWO-WAY CONVERSATION"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListenOtherPerson"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:text="🎤 Listen to Other Person's Response"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_dark"
            app:cornerRadius="12dp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/tvOtherPersonResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:text="Tap above to capture what the other person replies."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
