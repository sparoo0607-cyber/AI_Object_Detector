<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Top Header & Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="22dp"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_back_arrow"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:elevation="2dp"
                android:contentDescription="Back to Home" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/primary_blue"
                android:contentDescription="Settings" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAHEY SETTINGS"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Engines &amp; Language Model Manager"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- 1. Gemini Cloud AI Configuration Card (Matching Reference Screen 4 Top) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/primary_blue"
                        android:contentDescription="Sparkle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Gemini Multimodal Cloud AI"
                        android:textColor="@color/primary_blue"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter your Google Gemini API Key for deep visual reasoning and screen fire detection:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Gemini API Key (AIzaSy...)"
                    android:textColorHint="@color/text_muted"
                    app:boxBackgroundColor="@color/window_background"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/primary_blue"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveApiKey"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="SAVE API KEY"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="12sp"
                        app:backgroundTint="@color/primary_blue"
                        app:cornerRadius="10dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvApiKeyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Not configured"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. AI PERCEPTION MODULES Card (Matching Reference Screen 4 Middle) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AI PERCEPTION MODULES"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Object Identification -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_cube"
                        app:tint="@color/accent_green"
                        android:contentDescription="Object" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Object Identification (COCO)"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchObjectDetection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/primary_blue"
                        app:trackTint="@color/primary_blue_light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- 2. Danger & Hazard Radar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_warning_triangle"
                        app:tint="@color/accent_yellow"
                        android:contentDescription="Danger" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Danger &amp; Hazard Radar"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDangerDetection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/primary_blue"
                        app:trackTint="@color/primary_blue_light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- 3. Text OCR Reading -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_ocr_scan"
                        app:tint="@color/accent_green"
                        android:contentDescription="OCR" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Text OCR Reading"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOcr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/primary_blue"
                        app:trackTint="@color/primary_blue_light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- 4. Sign Language Recognition -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_hand_sign"
                        app:tint="@color/accent_purple"
                        android:contentDescription="Sign" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Sign Language Recognition"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSignLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/primary_blue"
                        app:trackTint="@color/primary_blue_light" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- 5. Environmental Sound Awareness -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        app:tint="@color/primary_blue"
                        android:contentDescription="Sound" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Environmental Sound Awareness"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSoundAwareness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/primary_blue"
                        app:trackTint="@color/primary_blue_light" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. ACCESSIBILITY & FEEDBACK (Matching Reference Screen 5 Top) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ACCESSIBILITY &amp; FEEDBACK"
            android:textColor="@color/accent_orange"
            android:textSize="11sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Vibration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_vibrate"
                        app:tint="@color/accent_orange"
                        android:contentDescription="Vibrate" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Tactile Vibration Feedback"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHaptics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/accent_orange"
                        app:trackTint="@color/accent_yellow_subtle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Hazard Preempts Speech -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_megaphone"
                        app:tint="@color/accent_orange"
                        android:contentDescription="Megaphone" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Hazard Preempts Speech"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPreemptSpeech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="@color/accent_orange"
                        app:trackTint="@color/accent_yellow_subtle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Offline Languages (Google ML Kit) (Matching Reference Screen 5 Middle) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_globe"
                        app:tint="@color/primary_blue"
                        android:contentDescription="Globe" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Offline Languages (Google ML Kit)"
                        android:textColor="@color/primary_blue"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Download language packs for 100% offline translation without internet:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- English Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English (Base Model)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/tvStatusEn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Ready for offline translation"
                            android:textColor="@color/accent_green"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadEn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DELETE"
                        android:textColor="@color/accent_red"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_red_subtle"
                        app:strokeColor="@color/accent_red_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Telugu Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English ↔ Telugu (తెలుగు)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusTe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadTe"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DOWNLOAD"
                        android:textColor="@color/accent_green"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_green_subtle"
                        app:strokeColor="@color/accent_green_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Hindi Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English ↔ Hindi (हिंदी)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusHi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadHi"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DOWNLOAD"
                        android:textColor="@color/accent_green"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_green_subtle"
                        app:strokeColor="@color/accent_green_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Tamil Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English ↔ Tamil (தமிழ்)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusTa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadTa"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DOWNLOAD"
                        android:textColor="@color/accent_green"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_green_subtle"
                        app:strokeColor="@color/accent_green_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Kannada Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English ↔ Kannada (ಕನ್ನಡ)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusKn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadKn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DOWNLOAD"
                        android:textColor="@color/accent_green"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_green_subtle"
                        app:strokeColor="@color/accent_green_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/surface_border_subtle" />

                <!-- Malayalam Model -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English ↔ Malayalam (മലയാളം)"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvStatusMl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking..."
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadMl"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="DOWNLOAD"
                        android:textColor="@color/accent_green"
                        android:textSize="10.5sp"
                        android:fontFamily="sans-serif-bold"
                        app:backgroundTint="@color/accent_green_subtle"
                        app:strokeColor="@color/accent_green_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:gravity="center"
            android:text="SAHEY Accessibility Platform • Version 2.0"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
