# Copy to `keystore.properties` (which is git-ignored) and fill in real values to sign
# release builds with your own key. If this file is absent, `assembleRelease` falls back
# to the bundled prototype key in app/release.keystore (DO NOT ship that key).
#
# `assembleDebug` never needs any of this.

storeFile=app/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
